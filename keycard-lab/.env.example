# Copy to .env. With no .env at all, every lab uses the LOCAL MOCK zone defaults.
# Never commit .env.

# --- Which zone -------------------------------------------------------------
# Mock (default):           http://localhost:9000
# Real Keycard zone:        https://<zone-id>.keycard.cloud
KEYCARD_ZONE_URL=http://localhost:9000
KEYCARD_ZONE_ID=mockzone

# Real zone only: GitHub calls go to the real API. Mock default: http://localhost:9000/github
# GITHUB_API_BASE=https://api.github.com
# DEMO_REPO=your-org/your-repo

# --- Public client for user sign-in (PKCE) ---------------------------------
# Real zone: create a public Application with redirect URI http://localhost:8765/callback
CLI_CLIENT_ID=oncall-cli

# --- One Application per agent/server (real zone: from Console > Applications)
# Mock defaults are built in; set these only for a real zone.
# GITHUB_MCP_CLIENT_ID=
# GITHUB_MCP_CLIENT_SECRET=
# INCIDENT_ORCHESTRATOR_CLIENT_ID=
# INCIDENT_ORCHESTRATOR_CLIENT_SECRET=
# TRIAGE_AGENT_CLIENT_ID=
# TRIAGE_AGENT_CLIENT_SECRET=
# NIGHTLY_DIGEST_CLIENT_ID=
# NIGHTLY_DIGEST_CLIENT_SECRET=
# ONCALL_LANGCHAIN_CLIENT_ID=
# ONCALL_LANGCHAIN_CLIENT_SECRET=

# --- Resource identifiers (must equal the Resource URLs in your zone) -------
# MCP_SERVER_URL=http://localhost:8000/
# MCP_RESOURCE=http://localhost:8000/mcp
# ORCHESTRATOR_URL=http://localhost:8001
# TRIAGE_URL=http://localhost:8002
# LANGCHAIN_AGENT_RESOURCE=http://localhost:8300
# GITHUB_RESOURCE=https://api.github.com
# REPORTS_RESOURCE=https://reports.internal.example

# Lab 08 with a real model (pip install langchain-anthropic):
# ANTHROPIC_API_KEY=
